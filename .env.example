# Supabase (Project Settings -> Data API / API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# LLM (OpenAI, used from Phase 2). Set LLM_MODEL to a GPT model your account can use.
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1
# Cheaper model for the dashboard AI assistant (defaults to gpt-4.1-mini when unset).
LLM_ASSISTANT_MODEL=gpt-4.1-mini

# Image generation (OpenAI). Leave IMAGE_API_KEY empty to reuse OPENAI_API_KEY.
# To use Gemini instead: IMAGE_PROVIDER=gemini, IMAGE_MODEL=gemini-2.5-flash-image and a paid Gemini key.
# With no working key, the app falls back to SVG placeholders.
IMAGE_PROVIDER=openai
IMAGE_MODEL=gpt-image-1
IMAGE_API_KEY=

# Web search (used from Phase 3). Leave the key empty to skip web search.
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
