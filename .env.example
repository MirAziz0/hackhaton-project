# Supabase (Project Settings -> Data API / API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# LLM (OpenAI, used from Phase 2). Set LLM_MODEL to a GPT model your account can use.
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1

# Image generation (used from Phase 2). Leave IMAGE_API_KEY empty to reuse OPENAI_API_KEY.
# With no key at all, the app falls back to SVG placeholders.
IMAGE_PROVIDER=openai
IMAGE_MODEL=gpt-image-1
IMAGE_API_KEY=

# Web search (used from Phase 3). Leave the key empty to skip web search.
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
